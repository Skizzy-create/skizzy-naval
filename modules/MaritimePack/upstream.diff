+++ "b/GameData/Maritime Pack/Patches/zz_MP_KSP1125_Compat.cfg"	2026-11-07 22:36:15.037565600 +0530
@@ -0,0 +1,32 @@
+// Maritime Pack - KSP 1.12.5 compatibility fixes (cfg side).
+// Requires ModuleManager (not bundled). Every patch only acts when MPUtils.dll is installed.
+// See CHANGES.md next to the GameData folder of this patched release for details.
+
+// 1) Typo in the flameout sound of both electric submarine stern engines: "EleclStop" does not exist,
+//    so the flameout sound was silently never created. The intended clip is Maritime Pack/Sounds/ElecStop.
+@PART[FS_SubmarineElecEngine1|FS_SubmarineElecEngine125]:NEEDS[MPUtils]:AFTER[MPUtils]
+{
+	@MODULE[MPengineSounds]
+	{
+		@flameout = Maritime Pack/Sounds/ElecStop
+	}
+}
+
+// 2) MPSub reads its depth limit from the KSPField "MaxDepth" (default 400 m, adjustable 400-2000 m in the
+//    editor). The Bathysphere and Sub Conning part cfgs spell it "maxDepth = 700", so the value was ignored
+//    and every sub started at 400 m. Copy it to the correct key and drop the misspelled one.
+@PART[*]:HAS[@MODULE[MPSub]:HAS[#maxDepth,~MaxDepth]]:NEEDS[MPUtils]:AFTER[MPUtils]
+{
+	@MODULE[MPSub]:HAS[#maxDepth,~MaxDepth]
+	{
+		MaxDepth = #$maxDepth$
+		!maxDepth = delete
+	}
+}
+
+// 3) MPUtils/Resources.cfg re-defines "Water" (flowMode STAGE_PRIORITY_FLOW) which Community Resource Pack
+//    already defines (flowMode ALL_VESSEL). KSP keeps the first definition and logs an error for the duplicate.
+//    When CRP is installed, remove the duplicate so only CRP's definition exists. Nothing changes without CRP.
+!RESOURCE_DEFINITION[Water]:HAS[#flowMode[STAGE_PRIORITY_FLOW]]:NEEDS[MPUtils&CommunityResourcePack]:AFTER[MPUtils]
+{
+}

