diff --git a/Patches/IronSeasKANES_Fallbacks.cfg b/Patches/IronSeasKANES_Fallbacks.cfg
new file mode 100644
index 0000000..97e4eaa
--- /dev/null
+++ b/Patches/IronSeasKANES_Fallbacks.cfg
@@ -0,0 +1,74 @@
+// Iron Seas KANES: fallbacks for missing optional plugins (KSP 1.12.5).
+// Part of the unofficial KSP 1.12.5 / BDArmory 1.13 update of Iron Seas KANES (original by SkunkWorksCommand), 2026-11. GPLv2, see LICENSE.txt.
+// Each patch below only runs when the named plugin is NOT installed, so a full install
+// (WildBlueTools + KerbalActuators + BonVoyage + Firespitter + NAS) is left unchanged.
+// :NEEDS[] checks plugin assembly names: WildBlueTools, KerbalActuators (bundled with WildBlueTools),
+// BonVoyage, Firespitter, Cavitation (= KerbalPowers Naval), and the NAS folder name.
+
+// ---------------------------------------------------------------------------------------------
+// 1) No WildBlueTools: remove the WBI ballast tank, its effects/ballast resource and the dive computer.
+//    Without a ballast module (none ships with stock KSP) the boat floats and can only run on the surface.
+// ---------------------------------------------------------------------------------------------
+@PART[BalaoClassHull]:NEEDS[!WildBlueTools]:FOR[IronSeasKANES]
+{
+	!MODULE[WBIBallastTank] {}
+	!EFFECTS {}
+	!RESOURCE[IntakeLqd] {}
+}
+
+@PART[BalaoClassSail]:NEEDS[!WildBlueTools]:FOR[IronSeasKANES]
+{
+	!MODULE[WBIDiveComputer] {}
+	@MODULE[ModuleSAS]
+	{
+		!UPGRADES {}	// WBIFlightControl2/3 are PARTUPGRADEs defined by WildBlueTools
+	}
+}
+
+// 1a) No WildBlueTools, but KerbalPowers Naval is installed: dive with its ModuleShipBallast instead.
+//     part.buoyancy is varied between minBuoyancy (flooded) and maxBuoyancy (surfaced, the hull's default 1.0).
+//     Starting values only - tune pumpRate/maxSpeed in flight testing. Needs ElectricCharge while pumping.
+@PART[BalaoClassHull]:NEEDS[!WildBlueTools,Cavitation]:FOR[IronSeasKANES]
+{
+	%buoyancy = 1.0
+	MODULE
+	{
+		name = ModuleShipBallast
+		maxBuoyancy = 1.0
+		minBuoyancy = 0
+		maxSpeed = 3		// m/s target ascent/descent rate
+		maxDepth = 190		// m, upper end of the target-depth slider (hull maxPressure 2300 kPa collapses at about 224 m)
+		pumpRate = 5		// % of maxBuoyancy per second (scaled down at low vertical speeds)
+		ECRequirement = 5	// EC/s while pumping
+	}
+}
+
+// ---------------------------------------------------------------------------------------------
+// 2) No KerbalActuators (normally installed with WildBlueTools): remove the air-park controller.
+// ---------------------------------------------------------------------------------------------
+@PART[BalaoClassSail]:NEEDS[!KerbalActuators]:FOR[IronSeasKANES]
+{
+	!MODULE[WBIAirParkController] {}
+}
+
+// ---------------------------------------------------------------------------------------------
+// 3) No BonVoyage: remove the rover/ship autopilot module (its PARTUPGRADEs come from BonVoyage itself).
+// ---------------------------------------------------------------------------------------------
+@PART[BalaoClassSail]:NEEDS[!BonVoyage]:FOR[IronSeasKANES]
+{
+	!MODULE[BonVoyageModule] {}
+}
+
+// ---------------------------------------------------------------------------------------------
+// 4) No Firespitter: remove the reverse-thrust switch from the screws (they still drive forward).
+// ---------------------------------------------------------------------------------------------
+@PART[BalaoClassScrew|CruiserScrewFast]:NEEDS[!Firespitter]:FOR[IronSeasKANES]
+{
+	!MODULE[FSswitchEngineThrustTransform] {}
+}
+
+// ---------------------------------------------------------------------------------------------
+// 5) No NAS or no BDArmory: nothing to patch. The deck guns are not loaded (PART:NEEDS[NAS,BDArmory]
+//    in their cfgs), the 4"/50 bullet is BULLET:NEEDS[BDArmory], and the antenna, periscope and snorkel
+//    now carry plain-text manufacturer/description in their own cfgs (no NAS localisation tags).
+// ---------------------------------------------------------------------------------------------
