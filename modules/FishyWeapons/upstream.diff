+// -------------------------------------------------------------------------------------
+// 2) ModuleWeapon.airDetonation / airDetonationTiming / maxAirDetonationRange /
+//    proximityDetonation were removed from BDA; fuzing is now per BULLET (fuzeType).
+//    Both CIWS parts used: airDetonation = true, airDetonationTiming = false,
+//    proximityDetonation = true  => proximity fuze, no timer  => fuzeType = Proximity.
+//    The two bullets are only fired by these two parts.
+//    maxAirDetonationRange -> defaultDetonationRange (BDA uses max(maxTargetingRange,
+//    defaultDetonationRange) to set the round's lifetime, i.e. how far it flies).
+// -------------------------------------------------------------------------------------
+@BULLET[anti-missile]:NEEDS[BDArmory]
+{
+	%fuzeType = Proximity
+}
+@BULLET[active_laser_missile_BULLET]:NEEDS[BDArmory]
+{
+	%fuzeType = Proximity
+	@bulletMass = 0.0001	// was 0.0: avoids a 0/0 in BDA's post-penetration mass calc (PooledBullet)
+}
+@PART[anti?missile?system]:NEEDS[BDArmory]
+{
+	@MODULE[ModuleWeapon]
+	{
+		!airDetonation = delete
+		!airDetonationTiming = delete
+		!proximityDetonation = delete
+		!maxAirDetonationRange = delete
+		%defaultDetonationRange = 1800
+		@explModelPath = BDArmory/Models/explosion/30mmExplosion	// was a .png (Fishy-Mod-Core/textures/low_res_boom), not a model
+	}
+}
+@PART[active_protection_sys]:NEEDS[BDArmory]
+{
+	@MODULE[ModuleWeapon]
+	{
+		!airDetonation = delete
+		!airDetonationTiming = delete
+		!proximityDetonation = delete
+		!maxAirDetonationRange = delete
+		%defaultDetonationRange = 100
+		@explModelPath = BDArmory/Models/explosion/30mmExplosion
+	}
+}
