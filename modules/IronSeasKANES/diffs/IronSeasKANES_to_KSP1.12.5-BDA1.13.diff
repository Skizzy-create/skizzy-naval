+// Iron Seas KANES: bullet for the Balao's 4"/50 deck gun (4InchGunBalaoClassForward/Rear).
+// Part of the unofficial KSP 1.12.5 / BDArmory 1.13 update of Iron Seas KANES (original by SkunkWorksCommand), 2026-11. GPLv2, see LICENSE.txt.
+// Neither BDArmory nor NAS ships a 4"/50 shell, so it is defined here (BDArmory BULLET format, 1.13).
+// Data: US 4"/50 Mk 9, H.C. Mk 15 Mod 1 shell, 33 lb (14.97 kg), bursting charge 2.71 lb (1.23 kg) Explosive D
+// (taken here as about 1.2 kg TNT), muzzle velocity 2,900 ft/s (884 m/s). Source: navweaps.com, WNUS_4-50_mk9.
+// Ammo resource on the gun: BDArmory's 100mmShells ("100 mm (4") Shell").
+BULLET:NEEDS[BDArmory]
+{
+	name = IronSeas4in50HC
+	DisplayName = 4in/50 HC (US)
+	caliber = 102
+	bulletVelocity = 884
+	bulletMass = 14.97
+	//HE Bullet Values
+	explosive = Standard
+	incendiary = False
+	tntMass = 1.2
+	fuzeType = Impact	// point-detonating, for surface targets
+	apBulletMod = 0.8
+	projectileCount = 1
+	bulletDragTypeName = AnalyticEstimate
+	projectileColor = 255, 250, 0, 255
+	fadeColor = False
+	startColor = 255, 250, 0, 255
+}
