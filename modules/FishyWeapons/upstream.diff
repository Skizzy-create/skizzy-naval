+// -------------------------------------------------------------------------------------
+// 3) Broken ammo / bullet / resource references. A bulletType that does not exist gives
+//    a null BulletInfo -> NullReferenceException in ModuleWeapon.ParseAmmoStats; an
+//    undefined ammoName/RESOURCE means the gun never has ammo.
+// -------------------------------------------------------------------------------------
+// "7mm fast (death-ray-edition)": "7mm fast" exists nowhere; the defined bullet+resource is "7mm-fast"
+@PART[7mm_fast_gun2]:NEEDS[BDArmory]
+{
+	@MODULE[ModuleWeapon]
+	{
+		@bulletType = 7mm-fast
+		@ammoName = 7mm-fast
+		@fireSoundPath = BDArmory/Parts/browninganm2/sounds/fire	// was .../Sounds/fire (KSP asset URLs are case-sensitive)
+	}
+	@RESOURCE[7mm?fast]
+	{
+		@name = 7mm-fast
+	}
+}
+// "7mm fast gun (Hu-7k)": fires fast7mm but carried 7mm-fast2, so it spawned with no usable ammo
+@PART[7mm_fast_gun]:NEEDS[BDArmory]
+{
+	@MODULE[ModuleWeapon]
+	{
+		@fireSoundPath = BDArmory/Parts/browninganm2/sounds/fire
+	}
+	@RESOURCE[7mm-fast2]
+	{
+		@name = fast7mm
+	}
+}
+// 102mm XE: weapon uses resource 102mm; the part carried undefined resource "102XE"
+@PART[102XE]:NEEDS[BDArmory]
