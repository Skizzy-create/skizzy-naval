<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MNWSFix for KSP 1.12.5 (.NET Framework 4.8). No BDArmory reference: BDArmory fields are accessed by name.
    Build:  dotnet build -c Release            (or MSBuild.exe MNWSFix.csproj -p:Configuration=Release -restore)
    Override the KSP install with -p:KSPRoot="C:\path\to\Kerbal Space Program".
    Output: bin\Release\MNWSFix.dll -> copy to GameData\Johnny\Plugins\
  -->
  <PropertyGroup>
    <KSPRoot Condition="'$(KSPRoot)' == ''">D:\Epic Games\KerbalSpaceProgram\English</KSPRoot>
    <KSPManaged>$(KSPRoot)\KSP_x64_Data\Managed</KSPManaged>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>MNWSFix</AssemblyName>
    <RootNamespace>MNWSFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS0618;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
