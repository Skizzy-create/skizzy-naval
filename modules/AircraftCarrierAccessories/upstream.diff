# upstream.diff - Aircraft Carrier Accessories (KFC): original extracted GameData vs patched GameData
# a/ = naval/AircraftCarrierAccessories/extracted/GameData   b/ = patched/AircraftCarrierAccessories/GameData
#
# Binary changes: none. KFC/Plugins/ACA.dll is shipped unchanged (verified to resolve fully against KSP 1.12.5).
#   ADDED    KFC/Patches/zz_KSP1125_BDA113_Compat.cfg (text, shown below)
#
# Suggested upstream code fix (not applied - binary): in CLLS.OnStart, null-check BaseTransform/BaseRenderer, e.g.
#   BaseTransform = part.FindModelTransform("Base");
#   BaseRenderer  = BaseTransform != null ? BaseTransform.GetComponent<MeshRenderer>() : null;
#   if (HighLogic.LoadedSceneIsFlight && BaseRenderer != null) BaseRenderer.enabled = false;
# (then the CLLS MODEL workaround in the patch file can be deleted).
#
diff --git a/KFC/Patches/zz_KSP1125_BDA113_Compat.cfg b/KFC/Patches/zz_KSP1125_BDA113_Compat.cfg
new file mode 100644
index 0000000..0f8540f
--- /dev/null
+++ b/KFC/Patches/zz_KSP1125_BDA113_Compat.cfg
@@ -0,0 +1,43 @@
+// =====================================================================================
+// Aircraft Carrier Accessories (KFC) - compatibility patch for KSP 1.12.5 (+ BDArmory 1.13)
+// Separate file on purpose: the original part configs are untouched.
+// =====================================================================================
+
+// -------------------------------------------------------------------------------------
+// 1) Enterprise carries Hangar + HangarStorage modules (Hangar mod by allista) with no
+//    guard. Without Hangar installed KSP logs "Cannot find a PartModule of typename
+//    'Hangar'/'HangarStorage'" every load and drops them anyway; remove them cleanly.
+//    With Hangar installed nothing changes (the model has trigger_hangar, hangar_space
+//    and launch_position, as those modules expect).
+// -------------------------------------------------------------------------------------
+@PART[Enterprise]:NEEDS[!Hangar]
+{
+	!MODULE[Hangar] {}
+	!MODULE[HangarStorage] {}
+}
+
+// -------------------------------------------------------------------------------------
+// 2) STOPGAP for CLLS ("Carrier Landing And Launching System").
+//    ACA.dll CLLS.OnStart does
+//        BaseTransform = part.FindModelTransform("Base");
+//        BaseRenderer  = BaseTransform.gameObject.GetComponent(typeof(MeshRenderer)) ...
+//    but CLLS.mu has no transform called "Base" (it has LaunchSystem, Core, Guide1,
+//    Guide2, Instruction, Trigger, Collider). OnStart therefore throws a
+//    NullReferenceException (logged as "Module CLLS threw during OnStart") before it
+//    applies the saved Activate/Launcher state, in the editor and in flight.
+//    Workaround: add a second, 1/1000-scale stock model whose hierarchy contains a
+//    "Base" transform with a MeshRenderer (stock tail fin). CLLS hides that renderer
+//    in flight itself (BaseRenderer.enabled = false). Proper fix belongs in ACA.dll:
+//    null-check BaseTransform/BaseRenderer in CLLS.OnStart.
+//    Delete this block if a fixed ACA.dll is installed.
+// -------------------------------------------------------------------------------------
+@PART[CLLS]
+{
+	MODEL
+	{
+		model = Squad/Parts/Aero/airplaneFins/TailFin
+		position = 0.0, 0.0, 0.0
+		scale = 0.001, 0.001, 0.001
+		rotation = 0, 0, 0
+	}
+}
