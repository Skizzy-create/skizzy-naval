<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SkizzyRig for KSP 1.12.5 (.NET Framework 4.8). No BDArmory reference: it only creates transforms that
    BDArmory's ModuleTurret / ModuleWeapon look up by name.
    Build:  dotnet build -c Release -p:DebugType=None -p:DebugSymbols=false
    Override the KSP install with -p:KSPRoot="C:\path\to\Kerbal Space Program".
    Output: bin\Release\SkizzyRig.dll -> GameData\IronSeasKANES\Plugins\
  -->
  <PropertyGroup>
    <KSPRoot Condition="'$(KSPRoot)' == ''">D:\Epic Games\KerbalSpaceProgram\English</KSPRoot>
    <KSPManaged>$(KSPRoot)\KSP_x64_Data\Managed</KSPManaged>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>SkizzyRig</AssemblyName>
    <RootNamespace>SkizzyRig</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Nullable>disable</Nullable>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS0618;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPManaged)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPManaged)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPManaged)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
