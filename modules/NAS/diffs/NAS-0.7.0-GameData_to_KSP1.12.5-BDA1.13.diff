-	blastPower = 0 
-	blastHeat = 0
-	blastRadius = 0
-	apBulletMod = 0
+	fuzeType = None
+	apBulletMod = 1.0
+	projectileCount = 1
 	bulletDragTypeName = AnalyticEstimate
+	projectileColor = 255, 50, 0, 160
+	fadeColor = True
+	startColor = 255, 105, 25, 120
 }
