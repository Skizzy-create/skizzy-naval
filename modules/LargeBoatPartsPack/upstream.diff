diff --git a/LShipPartsRequired/Patches/zz_KSP1125_BDA113_Compat.cfg b/LShipPartsRequired/Patches/zz_KSP1125_BDA113_Compat.cfg
new file mode 100644
index 0000000..ad5d411
--- /dev/null
+++ b/LShipPartsRequired/Patches/zz_KSP1125_BDA113_Compat.cfg
@@ -0,0 +1,135 @@
+// =====================================================================================
+// LargeBoatPartsPack - compatibility patch for KSP 1.12.5 + BDArmory Plus 1.13
+// Separate file on purpose: the original part configs are untouched.
+// Every block is either harmless on a stock install or guarded with :NEEDS[...].
+// =====================================================================================
+
+// -------------------------------------------------------------------------------------
+// 1) VLS cells (ModuleTurret + MissileTurret with 0 deg/s, 0 yaw range, 0 pitch range).
+//    BDA 1.13's weapon manager waits for a missile turret to point within fireFOV
+//    (default 5 deg) of the target before launching, and uses fireFOV as the
+//    tolerance for point-defence turret range checks. A fixed vertical cell can
+//    never "point", so launches were delayed or refused. fireFOV = 180 means
+//    "don't wait for the turret"; the missile's own maxOffBoresight check in
+//    GetLaunchAuthorization still decides whether a launch is possible.
+//    fireFOV is persistent and editable in the editor (1-180), so craft saved
+//    before this patch keep their old value until you change it in the PAW.
+// -------------------------------------------------------------------------------------
+@PART[ModernSuperVLS]:NEEDS[BDArmory]
+{
+	@MODULE[MissileTurret]
+	{
+		%fireFOV = 180
+	}
+}
+@PART[SubHullVLSshort]:NEEDS[BDArmory]
+{
+	@MODULE[MissileTurret]
+	{
+		%fireFOV = 180
+	}
+}
+@PART[VetteHullVLSshort]:NEEDS[BDArmory]
+{
+	@MODULE[MissileTurret]
+	{
+		%fireFOV = 180
+	}
+}
+
+// -------------------------------------------------------------------------------------
+// 2) Optional variable ballast for submarine hull sections (replaces the old
+//    BuoyancyControl idea). Only applied when KerbalPowers Naval is installed
+//    (its plugin assembly is named "Cavitation"; do NOT use NEEDS[KerbalPowers],
+//    that folder also exists when only KerbalPowers Armory is installed).
+//    maxBuoyancy = the stock hull value, so with the pump OFF nothing changes.
+//    With the pump ON the module trims part.buoyancy between 0.1 and 0.6 to hold
+//    the target depth. Bind "Enable/Disable Pump" and "Target Depth" to action
+//    groups / an axis so all sections act together.
+// -------------------------------------------------------------------------------------
+@PART[subhull|subbow|subhullshort|subhullstern|SubHullVLSshort|SubHullMFWvls]:NEEDS[Cavitation]
+{
+	MODULE
+	{
+		name = ModuleShipBallast
+		maxBuoyancy = 0.6
+		minBuoyancy = 0.1
+		maxSpeed = 3
+		maxDepth = 300
+		pumpRate = 5
+		ECRequirement = 2
+	}
+}
+
+// KerbalPowers Naval adds ModuleEngineFlooding (forces disableUnderwater = true) to every
+// ModuleEnginesFX that burns IntakeAir. LBP's submarine water jet uses IntakeAir as a
+// propellant workaround and must keep running submerged, so take it back off that part.
+@PART[SubmarineWaterJet]:NEEDS[Cavitation]:AFTER[Cavitation]
+{
+	!MODULE[ModuleEngineFlooding] {}
+}
+
+// -------------------------------------------------------------------------------------
+// 3) Asset/name fixes found by static scan (cosmetic, no behaviour change except the
+//    gimbal, which now works as the part config always intended).
+// -------------------------------------------------------------------------------------
+// SubmarineWaterJet: the model has no "nozzle" transform (only thrustTransform), so the
+// 28 deg gimbal never worked. Its EFFECTS point at SM_Marine/Sounds/*, a mod that is not
+// part of this pack; the same sounds ship in LShipPartsRequired/Sounds.
+@PART[SubmarineWaterJet]
+{
+	@MODULE[ModuleGimbal]
+	{
+		@gimbalTransformName = thrustTransform
+	}
+	@EFFECTS
+	{
+		@idle
+		{
+			@AUDIO
+			{
+				@clip = LShipPartsRequired/Sounds/MarineEngRun
+			}
+		}
+		@engage
+		{
+			@AUDIO
+			{
+				@clip = LShipPartsRequired/Sounds/sound_smmarinestart
+			}
+		}
+		@power
+		{
+			@AUDIO
+			{
+				@clip = LShipPartsRequired/Sounds/propFX
+			}
+		}
+	}
+}
+
+// DG10Kstern: animation is called "DGsternLights" in the model (Unity names are case-sensitive).
+@PART[DG10Kstern]
+{
+	@MODULE[ModuleLight]
+	{
+		@animationName = DGsternLights
+	}
+}
+
+// CruiserHeliHangar: typo "ight3" -> "light3".
+@PART[CruiserHeliHangar]
+{
+	@MODULE[ModuleLight]
+	{
+		@lightName = light1,light2,light3,light4,light5,light6
+	}
+}
+
+// SM_Industries/Resources/SMIresource.cfg adds an FSCoolant scanner to the STOCK
+// SurfaceScanner part. FSCoolant is not defined by the plugin-only Firespitter build
+// (or anything else installed), so the stock scanner shows a dead "FSCoolant" readout.
+@PART[SurfaceScanner]:AFTER[SM_Industries]
+{
+	!MODULE[ModuleResourceScanner]:HAS[#ResourceName[FSCoolant]] {}
+}
