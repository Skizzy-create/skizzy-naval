diff --git a/GameData/Advanced Weapons Pack/Patches/zz_AWP_BDA113_Compat.cfg b/GameData/Advanced Weapons Pack/Patches/zz_AWP_BDA113_Compat.cfg
new file mode 100644
--- /dev/null
+++ b/GameData/Advanced Weapons Pack/Patches/zz_AWP_BDA113_Compat.cfg
@@ -0,0 +1,64 @@
+// =====================================================================================
+// Advanced Weapons Pack 0.22 -> KSP 1.12.5 / BDArmory Plus 1.13 compat
+// Pure ModuleManager patch; the original configs are left untouched.
+//
+// The pack's only NKD dependency is the "狂飙一号" bomb (shortName "Castle Bravo NUCLEAR"),
+// a copy of North Kerbin Dynamics' Castle Bravo. It used:
+//   - BDExplosivePart { tntMass = 15000000000; explModelPath = NKD/effects/Explosion_Castle }
+//   - ModuleShockwave { explosiveYield = 15000000000 }  <- old NKD plugin module, not in NKDR
+//     or anywhere else, so KSP drops it ("Cannot find a PartModule of typename").
+// NKD Reborn (NKDR) builds the same bomb with BDA's BDModuleNuke (yield in kt), so convert
+// to that: 15e9 kg TNT = 15 Mt = yield 15000, same values as NKDR's harpCastleBravo.
+// The part is matched by author + ModuleShockwave so the Chinese part name never has to
+// appear in a patch.
+//
+// The bomb is kept for manual use only: BDArmory's AI never selects it (see the
+// MissileLauncher block at the end).
+// =====================================================================================
+
+// With NKDR installed, use its Castle Bravo explosion on the launcher, like NKDR's own part
+// (NKDR/effects/Explosion_Castle is the same effect the NKD path pointed at).
+@PART[*]:HAS[#author[hentai?chou],@MODULE[ModuleShockwave],@MODULE[MissileLauncher]]:NEEDS[BDArmory,NKDR]
+{
+	@MODULE[MissileLauncher]
+	{
+		%explModelPath = NKDR/effects/Explosion_Castle
+	}
+}
+
+@PART[*]:HAS[#author[hentai?chou],@MODULE[ModuleShockwave]]:NEEDS[BDArmory]
+{
+	!MODULE[ModuleShockwave] {}
+	!MODULE[BDExplosivePart] {}
+	MODULE
+	{
+		name = BDModuleNuke
+		thermalRadius = 7200	// clamps AoE to a max of this distance (as NKDR)
+		yield = 15000		// kilotons; was tntMass 15000000000 kg
+		fluence = 2.0
+		isEMP = false
+		reportingName = Castle Bravo AWP
+		flashModelPath = BDArmory/Models/explosion/nuke/nukeFlash
+		shockModelPath = BDArmory/Models/explosion/nuke/nukeShock
+		blastModelPath = BDArmory/Models/explosion/nuke/nukeBlast
+		plumeModelPath = BDArmory/Models/explosion/nuke/nukePlume
+		debrisModelPath = BDArmory/Models/explosion/nuke/nukeScatter
+		blastSoundPath = BDArmory/Models/explosion/nuke/nukeBoom
+	}
+
+	// Manual use only. BDArmory's MissileFire.UpdateList puts a weapon into its per-target-type
+	// lists (weaponTypesAir / Missile / Ground / SLW) only if the matching EngageableWeapon flag
+	// is on, and SmartPickWeapon_EngagementEnvelope (guard mode, parallel salvo) only picks from
+	// those lists. With all four flags off the AI never selects the bomb, but it stays in the
+	// weapon manager's list for manual selection and keeps its own "Fire Missile" button and
+	// action. Craft saved before this patch keep their saved flags (re-place the part), and the
+	// weapon manager's global "Engage ..." buttons set these flags on every weapon of the vessel.
+	@MODULE[MissileLauncher]
+	{
+		%engageAir = false
+		%engageMissile = false
+		%engageGround = false
+		%engageSLW = false
+	}
+	@description ^= :$: BDArmory AI never selects this bomb (its Engage options are off). Select it in the weapon manager or use its Fire Missile action.
+}
